# Copy to .env.local (never commit real values).
# Public values — safe for the browser. Found in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: no service-role key is needed or used. All admin access runs as the signed-in user under Row Level Security.
# If you ever add server-only secrets, never prefix them with NEXT_PUBLIC_.
